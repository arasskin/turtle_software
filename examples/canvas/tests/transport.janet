# Exercise the actual host, HTTP parser and WebSocket framing without OS sockets.
# Storage is a small test double; tests/store.janet separately tests the native adapter.
(import ../server)
(import ../../../janet-utils/websocket :as ws)
(import ../../../janet-utils/json)
(import ../../../janet-utils/tests/harness :as t)
(ev/go (fn [] (ev/sleep 8) (eprint "transport test timed out") (os/exit 1)))

(def directory (string "build/transport-test-" (os/getpid)))
(def saved @{})
(var writes 0)
(var closed false)
(def storage
  {:open (fn [_] saved)
   :records (fn [_] (map |[$ (saved $)] (keys saved)))
   :put (fn [_ entity text]
     (++ writes)
     (def id (if (zero? entity) (+ 1 (length saved)) entity))
     (put saved id text)
     id)
   :close (fn [_] (set closed true))})

(defn masked [message]
  (def frame (buffer (ws/frame 1 (json/encode message))))
  (def n (band (frame 1) 127))
  (def head (case n 126 4 127 10 2))
  (put frame 1 (bor (frame 1) 128))
  (def result (buffer/slice frame 0 head))
  (buffer/push-byte result 1 2 3 4)
  (for i head (length frame)
    (buffer/push-byte result (bxor (frame i) (+ 1 (% (- i head) 4)))))
  (string result))
(defn receive [client]
  (def packet (ev/take (client :out)))
  (def n (band (packet 1) 127))
  (json/decode (string/slice packet (case n 126 4 127 10 2))))
(defn send [client value] (ev/give (client :in) (masked value)))
(def clients @[])
(defn client [handler key actor cursor &opt origin]
  (def input (ev/chan 32))
  (def output (ev/chan 32))
  (var stopped false)
  (def conn
    {:read (fn [&] (unless stopped (ev/take input)))
     :write (fn [_ text &] (ev/give output text))
     :close (fn [&] (set stopped true) (ev/chan-close input))})
  (def c {:in input :out output :conn conn})
  (array/push clients c)
  (ev/go (fn [] (handler conn)))
  (ev/give input (string "GET /sync HTTP/1.1\r\nHost: 127.0.0.1:8787\r\nOrigin: "
    (or origin "http://127.0.0.1:8787") "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
    "Sec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"))
  (def handshake (ev/take output))
  (if origin
    (t/ok (string/has-prefix? "HTTP/1.1 403" handshake))
    (do
      (t/ok (string/has-prefix? "HTTP/1.1 101" handshake))
      (send c {"type" "hello" "key" key "actor" actor "cursor" cursor})))
  c)
(defn join [handler key actor cursor]
  (def c (client handler key actor cursor))
  (t/is= "snapshot-start" ((receive c) "type"))
  (var records @[])
  (var done false)
  (while (not done)
    (def message (receive c))
    (if (= "ready" (message "type"))
      (set done true)
      (array/concat records (message "records"))))
  [c records])
(defn stroke [id points &opt version]
  {"type" "put" "record" {"kind" "stroke" "id" id "version" (or version 1)
    "points" points "color" "#608cae" "width" 5 "complete" false "deleted" false}})

(server/run ["--data" directory] storage (fn [&] {:close (fn [&])})
  (fn [_ handler]
    (def key (slurp (string directory "/invite-key")))
    (client handler key "alice-001" "cursor-a1" "http://unrelated.example")
    (def bad (client handler "bad-key" "alice-001" "cursor-a1"))
    (t/is= true ((receive bad) "fatal"))
    (def [alice initial] (join handler key "alice-001" "cursor-a1"))
    (def [bob _] (join handler key "bob-00001" "cursor-b1"))
    (t/is= 0 (length initial))
    (send alice (stroke "stroke-a1" [[10 10] [20 20]]))
    (def a ((receive alice) "record"))
    (t/is= a ((receive bob) "record"))
    (t/is= 1 writes)
    (send bob (stroke "stroke-b1" [[10 20] [20 10]]))
    (def b ((receive bob) "record"))
    (t/is= b ((receive alice) "record"))
    (t/is= [1 2] [(a "order") (b "order")])
    (send alice (stroke "stroke-a1" [[10 10] [20 20] [30 30]] 2))
    (receive alice)
    (t/is= 3 (length (((receive bob) "record") "points")))
    (t/is= 2 (length saved))
    (send alice {"type" "put" "record" {"kind" "cursor" "id" "cursor-a1" "version" 1
      "name" "Alice" "color" "#608cae" "x" 90 "y" 80 "active" true "online" true}})
    (receive alice)
    (t/is= 90 (((receive bob) "record") "x"))
    (t/is= 3 (length saved))
    (send bob (stroke "stroke-a1" [[0 0]] 3))
    (t/is= "error" ((receive bob) "type"))
    (def [carol snapshot] (join handler key "carol-001" "cursor-c1"))
    (t/is= 3 (length snapshot))
    (:close (alice :conn))
    (t/is= false (((receive bob) "record") "online"))
    (receive carol)
    (each c clients (:close (c :conn)))))
(t/ok closed)
(os/rm (string directory "/invite-key"))
(os/rmdir (string directory "/store"))
(os/rmdir directory)
(os/exit (if (zero? (t/report)) 0 1))
