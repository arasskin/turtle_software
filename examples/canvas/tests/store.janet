(import ../build/canvas_store :as store)
(import ../../../janet-utils/tests/harness :as t)
(def directory (string "build/store-test-" (os/getpid) "-" (math/floor (* 1000 (os/time)))))
(os/mkdir directory)
(def db (store/open directory))
(def first-id (store/put db 0 "{\"kind\":\"cursor\",\"x\":1}"))
(def second-id (store/put db 0 "{\"kind\":\"stroke\",\"points\":[[1,1]]}"))
(store/put db first-id "{\"kind\":\"cursor\",\"x\":2}")
(def before (store/records db))
(t/is= 2 (length before))
(t/is= first-id ((before 0) 0))
(t/is= second-id ((before 1) 0))
(t/is= "{\"kind\":\"cursor\",\"x\":2}" ((before 0) 1))
(store/close db)
(def reopened (store/open directory))
(t/is= before (store/records reopened))
(store/close reopened)
(each name ["data.mdb" "lock.mdb" "datafriend.owner"]
  (def path (string directory "/" name))
  (when (os/stat path) (os/rm path)))
(os/rmdir directory)
(os/exit (if (zero? (t/report)) 0 1))
